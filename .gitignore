.venv/
__pycache__/
*.pyc
.pytest_cache/
.cache/
output/
output_*/
probe/
*.egg-info/

# Generated deterministically by tests/generate_synthetic.py; the test suite
# regenerates it automatically if missing (see test_visual_integration.py's
# ensure_fixture), so committing the binary would only be redundant weight.
tests/fixtures/*.mp4

# The reference video (~1GB, copyrighted broadcast content) used for local
# validation only — must never be pushed to a public repo. Evaluators supply
# their own URL; this is not part of the deliverable. See internal/STATE.md R2
# and internal/INTERVIEW_NOTES.md §B10.
Sherlock_video/

# Ad-hoc manual test-run output (result.json + saved frame PNG) — the same
# shape output_*/ above already excludes, just under a name that pattern
# doesn't match. Not part of the deliverable; re-generated by any real run.
my_test_run/

# Personal working notes and Claude's own operating-protocol file — kept
# locally for the candidate's own reference/interview prep, but not part of
# the public submission. Per the actual Quest1 submission flowchart, the
# repo must contain source code, README.md, APPROACH.md, prompts.txt, and
# "other files (configs, assets, outputs, etc.)" — CLAUDE.md and internal/
# notes are not on that list.
CLAUDE.md
internal/
